# data_file variant: baked-abs-path
#
# Compiles $(CURDIR) into the product as a string constant. The exact same
# mistake as -Wl,-rpath,$(CURDIR)/../lib, one layer up: there is no loader
# involved, so there is no loader diagnostic either -- just a file that is not
# there, reported by the program itself if it thought to check.
#
# The data file is INSTALLED, not merely read out of the source directory: it is
# copied to payload/share, because payload/src is what an install leaves behind.
# A recipe that read its data out of sourceDir would pass in the build tree and
# have nothing to read anywhere else.
CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra
BINDIR   = ../bin
SHAREDIR = ../share
LOOKUP   = -DLOOKUP_BAKED_ABS -DLOOKUP_NAME='"baked-abs-path"' -DDATA_DIR='"$(CURDIR)/../share"'
TARGET   = $(BINDIR)/portable-data-baked-abs-path

all: $(TARGET) $(SHAREDIR)/message.txt

$(SHAREDIR)/message.txt: message.txt
	mkdir -p $(SHAREDIR)
	cp message.txt $@

$(TARGET): main.c $(SHAREDIR)/message.txt
	mkdir -p $(BINDIR)
	$(CC) $(CFLAGS) $(LOOKUP) -o $@ main.c

clean:
	rm -rf $(BINDIR) $(SHAREDIR)

.PHONY: all clean
