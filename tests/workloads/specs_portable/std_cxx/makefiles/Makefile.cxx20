# C++ standard variant: c++20
#
# CXX is left overridable, as an ordinary Makefile leaves it. `c++` rather than
# `g++` in the default, because `c++` is the name the platform guarantees and
# `g++` is a particular implementation of it.
CXX     ?= c++
STD      = -std=c++20
CXXFLAGS ?= -O2 -Wall -Wextra
BINDIR   = ../bin
TARGET   = $(BINDIR)/portable-std-cxx20

all: $(TARGET)

$(TARGET): main.cpp
	mkdir -p $(BINDIR)
	$(CXX) $(STD) $(CXXFLAGS) -o $@ main.cpp

clean:
	rm -rf $(BINDIR)

.PHONY: all clean
