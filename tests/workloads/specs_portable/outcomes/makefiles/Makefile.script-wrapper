# outcomes variant: script-wrapper
#
# The declared entrypoint is a shell script that execs a compiled binary
# beside it. Extremely common -- it is how a program that needs an environment
# variable, a working directory or a library path gets one -- and it means the
# entrypoint is not an ELF at all. The wrapper locates its binary from $$0, so
# it survives being installed somewhere else; a wrapper with an absolute path
# in it would be the same mistake as an absolute rpath.
CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra
BINDIR   = ../bin
WRAPPED  = $(BINDIR)/portable-outcome-wrapped
TARGET   = $(BINDIR)/portable-outcome-script.sh

all: $(TARGET)

$(WRAPPED): main.c
	mkdir -p $(BINDIR)
	$(CC) $(CFLAGS) -o $@ main.c

$(TARGET): $(WRAPPED)
	mkdir -p $(BINDIR)
	printf '#!/bin/sh\n' > $@
	printf '# Generated by the build. Locates its binary relative to itself.\n' >> $@
	printf 'printf "WRAPPER=sh\\n"\n' >> $@
	printf 'd=$$(dirname "$$0")\n' >> $@
	printf 'exec "$$d/portable-outcome-wrapped" "$$@"\n' >> $@
	chmod 0755 $@

clean:
	rm -rf $(BINDIR)

.PHONY: all clean
