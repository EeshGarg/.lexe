# rpath variant: origin-double-quoted
#
# $ORIGIN with the wrong quotes. `$$` gets one dollar past make correctly, and
# then the double quotes let the SHELL expand $ORIGIN -- an ordinary
# environment variable that nobody has set -- to the empty string. The linker
# is handed /../lib. Identical damage to the $(pwd) variant, from the opposite
# direction: there the loss was make's, here it is the shell's.
#
# Everything below is identical across the variants except RPATH_ARG and LDEXTRA.
CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra -fPIC
BINDIR   = ../bin
LIBDIR   = ../lib
LIB      = $(LIBDIR)/libutil.so
APP      = $(BINDIR)/portable-rpath-origin-double-quoted
RPATH_ARG = "$$ORIGIN/../lib"
LDEXTRA   =
RPATH_OPT = -Wl,-rpath,$(RPATH_ARG)

all: $(APP)

$(LIB): libutil.c libutil.h
	mkdir -p $(LIBDIR)
	$(CC) $(CFLAGS) -shared -o $@ libutil.c

$(APP): app.c libutil.h $(LIB)
	mkdir -p $(BINDIR)
	$(CC) $(CFLAGS) -o $@ app.c -L$(LIBDIR) -lutil $(LDEXTRA) $(RPATH_OPT)

clean:
	rm -rf $(BINDIR) $(LIBDIR)

.PHONY: all clean
