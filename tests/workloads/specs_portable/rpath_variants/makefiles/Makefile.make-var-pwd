# rpath variant: make-var-pwd
#
# The reported shape, taken literally. In a Makefile \$(pwd) is not a command
# substitution -- it is a reference to a make VARIABLE named "pwd", which nobody
# defined, so make expands it to the empty string and the linker is handed a
# path with nothing in front of it. Anyone who writes this means \$(shell pwd).
#
# Everything below is identical across the six variants except RPATH_ARG. The
# product is payload/bin/portable-rpath-make-var-pwd plus payload/lib/libutil.so, and what
# each variant actually put in DT_RUNPATH / DT_RPATH is read out of the built
# file with readelf and recorded in the corpus index. Nothing here decides
# whether that string is acceptable; that is not a question a recipe can answer.
CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra -fPIC
BINDIR   = ../bin
LIBDIR   = ../lib
LIB      = $(LIBDIR)/libutil.so
APP      = $(BINDIR)/portable-rpath-make-var-pwd
RPATH_ARG = $(pwd)/../lib

all: $(APP)

$(LIB): libutil.c libutil.h
	mkdir -p $(LIBDIR)
	$(CC) $(CFLAGS) -shared -o $@ libutil.c

$(APP): app.c libutil.h $(LIB)
	mkdir -p $(BINDIR)
	$(CC) $(CFLAGS) -o $@ app.c -L$(LIBDIR) -lutil -Wl,-rpath,$(RPATH_ARG)

clean:
	rm -rf $(BINDIR) $(LIBDIR)

.PHONY: all clean
