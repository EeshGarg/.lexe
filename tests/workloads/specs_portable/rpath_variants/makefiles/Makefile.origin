# rpath variant: origin
#
# The relocatable idiom: a literal $ORIGIN, expanded by the dynamic loader at
# run time to the directory holding the binary. Two levels of quoting are needed
# to get it there intact -- $$ so make emits one dollar, single quotes so the
# shell does not expand it -- and the single most common way to get this wrong is
# to lose one of them.
#
# Everything below is identical across the six variants except RPATH_ARG. The
# product is payload/bin/portable-rpath-origin plus payload/lib/libutil.so, and what
# each variant actually put in DT_RUNPATH / DT_RPATH is read out of the built
# file with readelf and recorded in the corpus index. Nothing here decides
# whether that string is acceptable; that is not a question a recipe can answer.
CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra -fPIC
BINDIR   = ../bin
LIBDIR   = ../lib
LIB      = $(LIBDIR)/libutil.so
APP      = $(BINDIR)/portable-rpath-origin
RPATH_ARG = '$$ORIGIN/../lib'

all: $(APP)

$(LIB): libutil.c libutil.h
	mkdir -p $(LIBDIR)
	$(CC) $(CFLAGS) -shared -o $@ libutil.c

$(APP): app.c libutil.h $(LIB)
	mkdir -p $(BINDIR)
	$(CC) $(CFLAGS) -o $@ app.c -L$(LIBDIR) -lutil -Wl,-rpath,$(RPATH_ARG)

clean:
	rm -rf $(BINDIR) $(LIBDIR)

.PHONY: all clean
